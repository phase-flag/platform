# Phase Flag API — environment variable reference
# Copy to .env and fill in real values. Never commit .env to git.

# Database
PHASEFLAG_DATABASE_URL=postgresql+asyncpg://phaseflag:password@localhost:5432/phaseflag

# Auth secrets (generate with: openssl rand -base64 48)
PHASEFLAG_API_SECRET_KEY=change-me-in-production
PHASEFLAG_JWT_SECRET_KEY=change-jwt-secret-in-production

# Deployment mode: oss | saas | enterprise
PHASEFLAG_DEPLOYMENT_MODE=oss

# CORS (comma-separated origins)
PHASEFLAG_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
PHASEFLAG_LOG_LEVEL=INFO

# Stripe (SaaS mode only — use test keys for development)
PHASEFLAG_STRIPE_SECRET_KEY=sk_test_placeholder
PHASEFLAG_STRIPE_WEBHOOK_SECRET=whsec_placeholder
PHASEFLAG_STRIPE_PRO_PRICE_ID=price_placeholder_pro
PHASEFLAG_STRIPE_ENTERPRISE_PRICE_ID=price_placeholder_enterprise
