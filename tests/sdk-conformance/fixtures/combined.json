    {
      "name": "onboarding flow — multiple attributes determine variation",
      "description": "New users from mobile on premium plan see enhanced onboarding",
      "flags": {
        "onboarding-flow": {
          "id": "flag-onboarding",
          "key": "onboarding-flow",
          "name": "Onboarding Flow",
          "flag_type": "string",
          "status": "active",
          "environment": "production",
          "default_variation_id": "var-basic-onboard",
          "variations": [
            {"id": "var-premium-mobile", "key": "premium_mobile", "name": "Premium Mobile", "value": "premium_mobile_v2"},
            {"id": "var-premium-web", "key": "premium_web", "name": "Premium Web", "value": "premium_web_v2"},
            {"id": "var-basic-onboard", "key": "basic", "name": "Basic", "value": "basic_v1"}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [
                {"attribute": "plan", "operator": "is", "value": "premium"},
                {"attribute": "platform", "operator": "is", "value": "mobile"},
                {"attribute": "is_new_user", "operator": "is", "value": "true"}
              ],
              "variation_id": "var-premium-mobile"
            },
            {
              "priority": 2,
              "conditions": [
                {"attribute": "plan", "operator": "is", "value": "premium"},
                {"attribute": "is_new_user", "operator": "is", "value": "true"}
              ],
              "variation_id": "var-premium-web"
            }
          ]
        }
      },
      "context": {
        "user_id": "new-user-1",
        "attributes": {"plan": "premium", "platform": "mobile", "is_new_user": "true"}
      },
      "expected": {"flag_key": "onboarding-flow", "value": "premium_mobile_v2", "variation_key": "premium_mobile", "reason": "targeting_match"}
    },
