      },
      "context": {"user_id": "user-eu-1", "attributes": {"plan": "enterprise", "region": "EU"}},
      "expected": {
        "flag_key": "pricing-experiment",
        "value": {"currency": "EUR", "discount": 0.25, "seats": "unlimited"},
        "variation_key": "enterprise_eu",
        "reason": "targeting_match"
