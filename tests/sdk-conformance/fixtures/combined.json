{
  "suite": "combined",
  "description": "Complex real-world scenarios combining targeting, rollout, segments, multiple rules and flag types",
  "cases": [
    {
      "name": "feature launch — admin bypass then segment then rollout",
      "description": "Three-tier rollout: admins always get it, beta users 100%, others 10%",
      "flags": {
        "feature-launch": {
          "id": "flag-feature-launch",
          "key": "feature-launch",
          "name": "Feature Launch",
          "flag_type": "boolean",
          "status": "active",
          "environment": "production",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "role", "operator": "is", "value": "admin"}],
              "variation_id": "var-on"
            },
            {
              "priority": 2,
              "conditions": [{"attribute": "beta", "operator": "is", "value": "true"}],
              "variation_id": "var-on"
            },
            {
              "priority": 3,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 10},
                  {"variation_id": "var-off", "weight": 90}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "admin-user", "attributes": {"role": "admin"}},
      "expected": {"flag_key": "feature-launch", "value": true, "variation_key": "on", "reason": "targeting_match"}
    },
    {
      "name": "feature launch — beta user gets it",
      "description": "Beta user hits priority 2 rule",
      "flags": {
        "feature-launch-beta": {
          "id": "flag-feature-launch-beta",
          "key": "feature-launch-beta",
          "name": "Feature Launch Beta",
          "flag_type": "boolean",
          "status": "active",
          "environment": "production",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "role", "operator": "is", "value": "admin"}],
              "variation_id": "var-on"
            },
            {
              "priority": 2,
              "conditions": [{"attribute": "beta", "operator": "is", "value": "true"}],
              "variation_id": "var-on"
            },
            {
              "priority": 3,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 10},
                  {"variation_id": "var-off", "weight": 90}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "user-100", "attributes": {"beta": "true", "role": "user"}},
      "expected": {"flag_key": "feature-launch-beta", "value": true, "variation_key": "on", "reason": "targeting_match"}
    },
    {
      "name": "pricing experiment — enterprise plan with region",
      "description": "Show different pricing config based on plan and region combination",
      "flags": {
        "pricing-experiment": {
          "id": "flag-pricing-exp",
          "key": "pricing-experiment",
          "name": "Pricing Experiment",
          "flag_type": "json",
          "status": "active",
          "environment": "production",
          "default_variation_id": "var-price-default",
          "variations": [
            {
              "id": "var-price-ent-us",
              "key": "enterprise_us",
              "name": "Enterprise US",
              "value": {"currency": "USD", "discount": 0.20, "seats": "unlimited"}
            },
            {
              "id": "var-price-ent-eu",
              "key": "enterprise_eu",
              "name": "Enterprise EU",
              "value": {"currency": "EUR", "discount": 0.25, "seats": "unlimited"}
            },
            {
              "id": "var-price-default",
              "key": "standard",
              "name": "Standard",
              "value": {"currency": "USD", "discount": 0, "seats": 5}
            }
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [
                {"attribute": "plan", "operator": "is", "value": "enterprise"},
                {"attribute": "region", "operator": "is", "value": "EU"}
              ],
              "variation_id": "var-price-ent-eu"
            },
            {
              "priority": 2,
              "conditions": [
                {"attribute": "plan", "operator": "is", "value": "enterprise"}
              ],
              "variation_id": "var-price-ent-us"
            }
          ]
