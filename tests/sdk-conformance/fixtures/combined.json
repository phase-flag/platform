    {
      "name": "A/B test with region exclusion",
      "description": "A/B test runs globally except EU (GDPR), EU users get control",
      "flags": {
        "ab-test-global": {
          "id": "flag-ab-global",
          "key": "ab-test-global",
          "name": "AB Test Global",
          "flag_type": "string",
          "status": "active",
          "environment": "production",
          "default_variation_id": "var-control",
          "variations": [
            {"id": "var-control", "key": "control", "name": "Control", "value": "control"},
            {"id": "var-treatment", "key": "treatment", "name": "Treatment", "value": "treatment"}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "region", "operator": "one_of", "value": ["EU", "EEA"]}],
              "variation_id": "var-control"
            },
            {
              "priority": 2,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-control", "weight": 50},
                  {"variation_id": "var-treatment", "weight": 50}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "eu-user", "attributes": {"region": "EU"}},
      "expected": {"flag_key": "ab-test-global", "value": "control", "variation_key": "control", "reason": "targeting_match"}
    },
