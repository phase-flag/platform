{
  "suite": "edge_cases",
  "description": "Edge cases: empty context, missing attributes, null values, malformed/extreme inputs",
  "cases": [
    {
      "name": "empty context — no user_id, no attributes",
      "description": "Evaluation with completely empty context — uses default variation",
      "flags": {
        "edge-empty-ctx": {
          "id": "flag-edge-empty-ctx",
          "key": "edge-empty-ctx",
          "name": "Edge Empty Context",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "country", "operator": "is", "value": "US"}],
              "variation_id": "var-on"
            }
          ]
        }
      },
      "context": {"attributes": {}},
      "expected": {"flag_key": "edge-empty-ctx", "value": false, "variation_key": "off", "reason": "default"}
    },
    {
      "name": "missing required attribute — is operator",
      "description": "is operator with missing attribute returns false (not a negation operator)",
      "flags": {
        "edge-missing-is": {
          "id": "flag-edge-missing-is",
          "key": "edge-missing-is",
          "name": "Edge Missing Is",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "country", "operator": "is", "value": "US"}],
              "variation_id": "var-on"
            }
          ]
        }
      },
      "context": {"user_id": "user-1", "attributes": {}},
      "expected": {"flag_key": "edge-missing-is", "value": false, "variation_key": "off", "reason": "default"}
    },
