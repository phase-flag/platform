{
  "suite": "operators",
  "description": "Tests all 11 targeting operators across various data types",
  "cases": [
    {
      "name": "is operator matches exact string",
      "description": "Condition: country is 'US' — user country is 'US'",
      "flags": {
        "op-is-match": {
          "id": "flag-op-is-1",
          "key": "op-is-match",
          "name": "Is Match",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "country", "operator": "is", "value": "US"}],
              "variation_id": "var-on"
            }
          ]
        }
      },
      "context": {"user_id": "user-1", "attributes": {"country": "US"}},
      "expected": {"flag_key": "op-is-match", "value": true, "variation_key": "on", "reason": "targeting_match"}
    },
    {
      "name": "is operator no match",
      "description": "Condition: country is 'US' — user country is 'CA'",
      "flags": {
        "op-is-no-match": {
          "id": "flag-op-is-2",
          "key": "op-is-no-match",
          "name": "Is No Match",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "country", "operator": "is", "value": "US"}],
              "variation_id": "var-on"
            }
          ]
        }
      },
      "context": {"user_id": "user-2", "attributes": {"country": "CA"}},
      "expected": {"flag_key": "op-is-no-match", "value": false, "variation_key": "off", "reason": "default"}
    },
    {
      "name": "is_not operator matches when values differ",
      "description": "Condition: plan is_not 'free' — user has plan 'pro'",
