          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [{"attribute": "beta", "operator": "is", "value": "true"}],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 100}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "user-010", "attributes": {"beta": "true"}},
      "expected": {"flag_key": "targeted-rollout", "value": true, "variation_key": "on", "reason": "percentage_rollout"}
    },
