            {
              "priority": 1,
              "conditions": [{"attribute": "role", "operator": "is", "value": "admin"}],
              "variation_id": "var-on"
            },
            {
              "priority": 2,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 10},
                  {"variation_id": "var-off", "weight": 90}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "admin-user", "attributes": {"role": "admin"}},
      "expected": {"flag_key": "rollout-with-target", "value": true, "variation_key": "on", "reason": "targeting_match"}
