    {
      "name": "targeted rollout — only matching users enter rollout",
      "description": "Rollout only for beta users via targeting condition, non-beta gets default",
      "flags": {
        "targeted-rollout": {
          "id": "flag-targeted-rollout",
          "key": "targeted-rollout",
          "name": "Targeted Rollout",
          "flag_type": "boolean",
