    {
      "name": "rollout with additional targeting rule — exact match wins over rollout",
      "description": "Admin user hits exact targeting rule (priority 1) before rollout rule (priority 2)",
      "hash_seed": {"flag_key": "rollout-with-target", "user_id": "admin-user", "expected_bucket": null},
