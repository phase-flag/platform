{
  "suite": "rollout",
  "description": "Percentage rollout tests using deterministic DJB2 hash bucketing. Hash: djb2(flagKey:userId) % 100",
  "hash_notes": {
    "algorithm": "DJB2 — seed=5381, h=((h<<5)+h+char) & 0xFFFFFFFF, bucket=hash%100",
    "input_format": "{flag_key}:{user_id}"
  },
  "cases": [
    {
      "name": "50% rollout — user in rollout (bucket < 50)",
      "description": "rollout-50:user-010 -> bucket=3, which is < 50, so user gets 'on' variation",
      "hash_seed": {"flag_key": "rollout-50", "user_id": "user-010", "expected_bucket": 3},
      "flags": {
        "rollout-50": {
          "id": "flag-rollout-50",
          "key": "rollout-50",
          "name": "50 Percent Rollout",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 50},
                  {"variation_id": "var-off", "weight": 50}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "user-010", "attributes": {}},
      "expected": {"flag_key": "rollout-50", "value": true, "variation_key": "on", "reason": "percentage_rollout"}
    },
    {
      "name": "50% rollout — user outside rollout (bucket >= 50)",
      "description": "rollout-50:user-001 -> bucket=71, which is >= 50, so user gets 'off' variation",
      "hash_seed": {"flag_key": "rollout-50", "user_id": "user-001", "expected_bucket": 71},
      "flags": {
        "rollout-50": {
          "id": "flag-rollout-50",
          "key": "rollout-50",
          "name": "50 Percent Rollout",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 50},
                  {"variation_id": "var-off", "weight": 50}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "user-001", "attributes": {}},
      "expected": {"flag_key": "rollout-50", "value": false, "variation_key": "off", "reason": "percentage_rollout"}
    },
    {
      "name": "100% rollout — all users get on variation",
      "description": "rollout-100:user-001 -> any bucket < 100, so always matches",
      "flags": {
        "rollout-100": {
          "id": "flag-rollout-100",
          "key": "rollout-100",
          "name": "100 Percent Rollout",
          "flag_type": "boolean",
