        "rollout-25": {
          "id": "flag-rollout-25",
          "key": "rollout-25",
          "name": "25 Percent Rollout",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {"id": "var-on", "key": "on", "name": "On", "value": true},
            {"id": "var-off", "key": "off", "name": "Off", "value": false}
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [],
              "percentage_rollout": {
                "variations": [
                  {"variation_id": "var-on", "weight": 25},
                  {"variation_id": "var-off", "weight": 75}
                ]
              }
            }
          ]
        }
      },
      "context": {"user_id": "user-001", "attributes": {}},
      "expected": {"flag_key": "rollout-25", "value": false, "variation_key": "off", "reason": "percentage_rollout"}
