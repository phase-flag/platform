      "name": "25% rollout — user-001 bucket=25, NOT in rollout (weight 25 means bucket < 25)",
      "description": "rollout-25:user-001 -> bucket=25, which equals 25 so NOT < 25, user gets off variation",
      "hash_seed": {"flag_key": "rollout-25", "user_id": "user-001", "expected_bucket": 25},
