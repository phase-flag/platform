{
  "suite": "defaults",
  "description": "Default value fallback scenarios \u2014 when no targeting rule matches, the default_variation_id is returned",
  "cases": [
    {
      "name": "no rules \u2014 returns default variation",
      "description": "Flag with no targeting rules always returns the default variation",
      "flags": {
        "no-rules-flag": {
          "id": "flag-no-rules",
          "key": "no-rules-flag",
          "name": "No Rules Flag",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {
              "id": "var-on",
              "key": "on",
              "name": "On",
              "value": true
            },
            {
              "id": "var-off",
              "key": "off",
              "name": "Off",
              "value": false
            }
          ],
          "targeting_rules": []
        }
      },
      "context": {
        "user_id": "user-1",
        "attributes": {}
      },
      "expected": {
        "flag_key": "no-rules-flag",
        "value": false,
        "variation_key": "off",
        "reason": "default"
      }
    },
    {
      "name": "all rules fail \u2014 returns default variation",
      "description": "Flag has rules but none match \u2014 falls back to default",
      "flags": {
        "rules-fail-flag": {
          "id": "flag-rules-fail",
          "key": "rules-fail-flag",
          "name": "Rules Fail Flag",
          "flag_type": "boolean",
          "status": "active",
          "environment": "test",
          "default_variation_id": "var-off",
          "variations": [
            {
              "id": "var-on",
              "key": "on",
              "name": "On",
              "value": true
            },
            {
              "id": "var-off",
              "key": "off",
              "name": "Off",
              "value": false
            }
          ],
          "targeting_rules": [
            {
              "priority": 1,
              "conditions": [
                {
                  "attribute": "plan",
                  "operator": "is",
                  "value": "enterprise"
                }
              ],
              "variation_id": "var-on"
            }
          ]
        }
      },
      "context": {
        "user_id": "user-2",
        "attributes": {
          "plan": "free"
        }
      },
      "expected": {
        "flag_key": "rules-fail-flag",
        "value": false,
        "variation_key": "off",
        "reason": "default"
      }
    },
