# =============================================================================
# Phase Flag — Production Environment Variables
# =============================================================================
# Copy this file to /opt/phaseflag/.env.production and fill in every value.
# NEVER commit the filled-in .env.production to version control.
#
# The deploy script expects this file at: /opt/phaseflag/.env.production
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment mode
# Options: oss | saas | enterprise
# -----------------------------------------------------------------------------
PHASEFLAG_DEPLOYMENT_MODE=saas

# Image tag to pull (e.g. "latest", "v1.2.3", or a Git SHA)
PHASEFLAG_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Password for the phaseflag Postgres user
PHASEFLAG_DB_PASSWORD=change-me-strong-random-password

# Full asyncpg URL — constructed automatically by compose from PHASEFLAG_DB_PASSWORD.
# Override here only if using an external managed database.
# PHASEFLAG_DATABASE_URL=postgresql+asyncpg://phaseflag:PASSWORD@db:5432/phaseflag

# -----------------------------------------------------------------------------
# Secrets — generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
PHASEFLAG_JWT_SECRET_KEY=replace-with-64-char-hex-string
PHASEFLAG_API_SECRET_KEY=replace-with-64-char-hex-string

# -----------------------------------------------------------------------------
# Domains
# Update to match your actual domain names.
# -----------------------------------------------------------------------------
API_DOMAIN=api.phaseflag.io
DASHBOARD_DOMAIN=app.phaseflag.io
PORTAL_DOMAIN=portal.phaseflag.io
RELAY_DOMAIN=relay.phaseflag.io

# Comma-separated list of allowed CORS origins for the API
PHASEFLAG_CORS_ORIGINS=https://app.phaseflag.io,https://portal.phaseflag.io

# -----------------------------------------------------------------------------
# SSL — path to Let's Encrypt / custom cert directory on the host
# The nginx config expects: $SSL_CERT_DIR/live/<domain>/fullchain.pem
# -----------------------------------------------------------------------------
SSL_CERT_DIR=/etc/letsencrypt

# -----------------------------------------------------------------------------
# Relay proxy
# -----------------------------------------------------------------------------
# API key used by the relay to authenticate with the API
PHASEFLAG_RELAY_API_KEY=replace-with-relay-api-key

# How often the relay polls the API for flag updates
PHASEFLAG_RELAY_POLL_INTERVAL=30s

# How long evaluated results are cached in the relay
PHASEFLAG_RELAY_CACHE_TTL=5m

# -----------------------------------------------------------------------------
# Stripe billing (required for SaaS/Enterprise deployment mode)
# Obtain from https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Live secret key (sk_live_...) — use sk_test_... for staging
PHASEFLAG_STRIPE_SECRET_KEY=sk_live_replace_me

# Webhook signing secret — from Stripe Dashboard > Webhooks
PHASEFLAG_STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe Price IDs — create in Stripe Dashboard or run: infra/stripe/setup.json
PHASEFLAG_STRIPE_PRO_PRICE_ID=price_replace_me_pro_monthly
PHASEFLAG_STRIPE_ENTERPRISE_PRICE_ID=price_replace_me_enterprise_monthly

# -----------------------------------------------------------------------------
# Logging
# Options: DEBUG | INFO | WARNING | ERROR
# -----------------------------------------------------------------------------
PHASEFLAG_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Enterprise (only required when PHASEFLAG_DEPLOYMENT_MODE=enterprise)
# -----------------------------------------------------------------------------
# PHASEFLAG_LICENSE_KEY=pf_ent_replace_me

# SSO — SAML 2.0
# PHASEFLAG_SAML_IDP_METADATA_URL=https://idp.example.com/metadata
# PHASEFLAG_SAML_SP_ENTITY_ID=https://app.phaseflag.io/saml/metadata
# PHASEFLAG_SAML_SP_ACS_URL=https://app.phaseflag.io/saml/acs

# SSO — OIDC
# PHASEFLAG_OIDC_ISSUER=https://idp.example.com
# PHASEFLAG_OIDC_CLIENT_ID=phaseflag
# PHASEFLAG_OIDC_CLIENT_SECRET=replace_me
