{
  "name": "@phaseflag/js-sdk",
  "version": "0.1.0",
  "description": "Phase Flag feature flag JavaScript/TypeScript SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "echo 'No tests yet' && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phaseflag/phaseflag.git",
    "directory": "sdks/javascript"
  },
  "homepage": "https://docs.phaseflag.dev/sdks/javascript",
  "bugs": {
    "url": "https://github.com/phaseflag/phaseflag/issues"
  },
  "author": "Phase Flag <support@phaseflag.com>",
  "keywords": ["feature-flags", "phaseflag", "phase-flag", "sdk", "feature-management"],
  "license": "Apache-2.0",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
