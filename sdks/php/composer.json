{
    "name": "phaseflag/sdk-php",
    "description": "Phase Flag PHP SDK for feature flag evaluation with local caching, targeting rules, and event tracking.",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "feature-flags",
        "feature-toggles",
        "phaseflag",
        "phase-flag",
        "sdk"
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "PhaseFlag\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhaseFlag\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
