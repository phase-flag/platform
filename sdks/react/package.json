{
  "name": "@phaseflag/react",
  "version": "0.1.0",
  "description": "Phase Flag React SDK — hooks and components for client-side feature flags",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --external react",
    "dev": "tsup src/index.tsx --format cjs,esm --dts --external react --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phaseflag/phaseflag.git",
    "directory": "sdks/react"
  },
  "homepage": "https://docs.phaseflag.dev/sdks/react",
  "bugs": {
    "url": "https://github.com/phaseflag/phaseflag/issues"
  },
  "author": "Phase Flag <support@phaseflag.com>",
  "keywords": ["feature-flags", "phaseflag", "phase-flag", "sdk", "react", "hooks", "feature-management"],
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "@phaseflag/js-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@phaseflag/js-sdk": "file:../javascript",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
