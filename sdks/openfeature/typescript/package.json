{
  "name": "@phaseflag/openfeature-provider",
  "version": "0.1.0",
  "description": "OpenFeature provider for Phase Flag",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": ["feature-flags", "phaseflag", "openfeature", "provider"],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@openfeature/server-sdk": ">=1.0.0",
    "@phaseflag/sdk-js": ">=0.1.0"
  },
  "devDependencies": {
    "@openfeature/server-sdk": "^1.13.0",
    "@phaseflag/sdk-js": "^0.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
