name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  lint-format:
    name: Biome — lint + format
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: biomejs/setup-biome@v2
        with: { version: latest }
      - run: biome ci .

  typecheck-build:
    name: Typecheck + build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with: { node-version: 22, cache: pnpm }
      - run: pnpm install --frozen-lockfile

      # Build shared packages first (turbo handles order)
      - name: Typecheck all
        run: pnpm typecheck

      - name: Build all
        run: pnpm build

  # Optional: enable when you add Playwright tests
