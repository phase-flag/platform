{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target":           "ES2017",
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "jsx":              "preserve",
    "noEmit":           true,
    "lib":              ["dom", "dom.iterable", "esnext"],
    "resolveJsonModule":    true,
    "isolatedModules":      true,
    "allowJs":              false,
    "incremental":          true,
    "plugins":              [{ "name": "next" }]
  },
  "include":  ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude":  ["node_modules"]
}
