# {{PRODUCT_NAME}} API — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# Server
NODE_ENV=development
PORT={{API_PORT}}
HOST=0.0.0.0

# Auth
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER={{PG_USER}}
PG_PASSWORD={{PG_PASSWORD}}
PG_DB={{PG_DB}}
DATABASE_URL=postgresql://{{PG_USER}}:{{PG_PASSWORD}}@localhost:5432/{{PG_DB}}

{{#if INCLUDES_GRAPH}}# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD={{NEO4J_PASSWORD}}

{{/if}}# External APIs (add as needed)
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:{{APP_PORT}},https://{{APP_DOMAIN}}
