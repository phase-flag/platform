# ============================================================
# Phase Flag — Local Environment Configuration
# Copy to .env and fill in values before running docker compose
# Generate secrets: openssl rand -base64 32
# ============================================================

# --- Database ---
DB_PASSWORD=change_me_use_openssl_rand

# --- API Secrets (generate with: openssl rand -base64 32) ---
JWT_SECRET=change_me_use_openssl_rand
API_SECRET=change_me_use_openssl_rand

# --- Deployment Mode: oss | saas | enterprise ---
DEPLOYMENT_MODE=oss

# --- CORS origins (comma-separated, must include all frontend origins) ---
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5174,http://localhost:5175

# --- Log level: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO

# --- Relay ---
RELAY_API_KEY=

# --- Stripe (SaaS mode only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# --- Frontend API URL (baked into static builds) ---
# Use /api/v1 (relative) when accessing frontends via the nginx gateway at :80
# Use http://localhost:8000/api/v1 when accessing frontends directly on their own ports
# Change and run: docker compose -f docker-compose.local.yml build && docker compose -f docker-compose.local.yml up -d
VITE_API_URL=/api/v1

# --- Production overrides (uncomment when deploying) ---
# VITE_API_URL=https://api.yourdomain.com/api/v1
# API_EXTERNAL_URL=https://api.yourdomain.com
