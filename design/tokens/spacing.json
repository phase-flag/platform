{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "Phase Flag spacing scale — follows Tailwind's default 4px base unit.",

  "base": { "value": "4px", "comment": "1 spacing unit = 4px" },

  "scale": {
    "0":   { "value": "0px" },
    "px":  { "value": "1px" },
    "0.5": { "value": "2px" },
    "1":   { "value": "4px" },
    "1.5": { "value": "6px" },
    "2":   { "value": "8px" },
    "2.5": { "value": "10px" },
    "3":   { "value": "12px" },
    "3.5": { "value": "14px" },
    "4":   { "value": "16px" },
    "5":   { "value": "20px" },
    "6":   { "value": "24px" },
    "7":   { "value": "28px" },
    "8":   { "value": "32px" },
    "9":   { "value": "36px" },
    "10":  { "value": "40px" },
    "11":  { "value": "44px" },
    "12":  { "value": "48px" },
    "14":  { "value": "56px" },
    "16":  { "value": "64px" },
    "20":  { "value": "80px" },
    "24":  { "value": "96px" },
    "28":  { "value": "112px" },
    "32":  { "value": "128px" }
  },

  "semantic": {
    "sectionPaddingY":  { "value": "80px",  "comment": "py-20 — standard section vertical padding" },
    "sectionPaddingYL": { "value": "112px", "comment": "py-28 — large screens" },
    "containerPaddingX":{ "value": "16px",  "comment": "px-4 mobile, px-6 sm, px-8 lg" },
    "cardPadding":      { "value": "24px",  "comment": "p-6 card interior" },
    "inputPaddingX":    { "value": "16px",  "comment": "px-4 inputs" },
    "inputPaddingY":    { "value": "8px",   "comment": "py-2 inputs" },
    "buttonPaddingX":   { "value": "16px",  "comment": "px-4 default button" },
    "buttonPaddingXL":  { "value": "20px",  "comment": "px-5 large CTA button" },
    "navHeight":        { "value": "64px",  "comment": "h-16 mobile nav" },
    "navHeightL":       { "value": "80px",  "comment": "h-20 large nav" }
  },

  "borderRadius": {
    "sm":   { "value": "6px",   "comment": "rounded" },
    "md":   { "value": "8px",   "comment": "rounded-lg" },
    "lg":   { "value": "12px",  "comment": "rounded-xl — cards, buttons" },
    "xl":   { "value": "16px",  "comment": "rounded-2xl" },
    "full": { "value": "9999px","comment": "rounded-full — badges, toggles" }
  }
}
