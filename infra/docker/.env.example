# Phase Flag — Docker Compose Environment Variables
# Copy to .env and fill in values before running docker compose up.

# --- Required Secrets (generate with: openssl rand -base64 32) ---
PHASEFLAG_DB_PASSWORD=
PHASEFLAG_JWT_SECRET_KEY=
PHASEFLAG_API_SECRET_KEY=

# --- Optional Configuration ---
# PHASEFLAG_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# PHASEFLAG_LOG_LEVEL=INFO
# PHASEFLAG_DEPLOYMENT_MODE=oss

# --- Enterprise Mode (requires license) ---
# PHASEFLAG_LICENSE_KEY=
# PHASEFLAG_RELAY_API_KEY=
# PHASEFLAG_API_EXTERNAL_URL=https://api.your-domain.com
